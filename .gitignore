# Git ignore for common files and directories

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
package-lock.json # sometimes committed, but often ignored
pnpm-lock.yaml # sometimes committed, but often ignored

# Python
__pycache__/
*.pyc
.venv/
env/

# Editor/IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build/Output
build/
dist/
target/
*.log
*.tmp
*.swp
*.bak
*.swo

# OS specific
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Gemini CLI specific temporary files
.gemini/tmp/
